
<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Home.HomeFragment">

    <!-- Background Header -->
    <View
        android:id="@+id/background_header"
        android:layout_width="0dp"
        android:layout_height="300dp"
        android:background="@drawable/bg_header_wave"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_scrollFlags="scroll|enterAlways"
        app:subtitleTextColor="@android:color/white"
        app:titleTextColor="@android:color/white" />

    <!-- Teks Selamat Datang -->
    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="68dp"
        android:text="Selamat Datang"
        android:textSize="25sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- GridLayout untuk semua tombol -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridMenu"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:padding="8dp"
        app:columnCount="2"
        app:useDefaultMargins="true"
        app:layout_constraintTop_toBottomOf="@id/textView4"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Button P4 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToFourth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Button P4"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Button P5 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnP5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Button P5"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Button P7 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToSeventh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Button P7"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Button P10 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToTen"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Button P10"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

        <!-- Button Logout -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Logout"
            app:layout_columnWeight="1"
            app:layout_gravity="fill_horizontal" />

    </androidx.gridlayout.widget.GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
